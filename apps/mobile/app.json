{
  "expo": {
    "name": "Outsee",
    "slug": "oracle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oracle",
    "userInterfaceStyle": "light",
    "ios": {
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.erikt.oracle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "ORACLE never asks for or uses your location. This notice exists only because a bundled notifications library ships location features that this app leaves switched off."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "ORACLE lets the orb answer the way you move the phone. Motion is read on-device only and never leaves it."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.erikt.oracle.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.erikt.oracle.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "aaad68b1-71b3-49c2-ab03-434f36caef92"
      }
    },
    "owner": "eriktaheris-team"
  }
}
