{
  "name": "oracle-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "PIPELINE_AUTHOR_MODEL": "claude-opus-5", "PIPELINE_RESOLVE_MODEL": "claude-sonnet-5" }
  // secrets (wrangler secret put): DEVICE_TOKEN_SECRET, ADMIN_SECRET, DATABASE_URL,
  // ANTHROPIC_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, TELEGRAM_WEBHOOK_SECRET,
  // PIPELINE_ENABLED ("true" to arm the cron pipeline)
}
