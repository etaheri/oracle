{
  "name": "oracle-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "workflows": [
    { "name": "oracle-authoring", "binding": "AUTHORING_WORKFLOW", "class_name": "AuthoringWorkflow" },
    { "name": "oracle-resolution", "binding": "RESOLUTION_WORKFLOW", "class_name": "ResolutionWorkflow" },
    { "name": "oracle-council", "binding": "COUNCIL_WORKFLOW", "class_name": "CouncilWorkflow" }
  ],
  "vars": {
    "PIPELINE_AUTHOR_MODEL": "claude-opus-5",
    "PIPELINE_RESOLVE_MODEL": "claude-sonnet-5",
    "PIPELINE_RESOLVE_MODEL_B": "claude-opus-5",
    "PIPELINE_FORECAST_MODEL": "claude-sonnet-5",
    // Classification against a fixed list, not open-ended judgement, so the
    // cheapest model carries it. Unlike RESOLVE_MODEL_B, nothing here depends
    // on this model differing from any other.
    "PIPELINE_TASTE_MODEL": "claude-haiku-4-5-20251001",
    "PIPELINE_VOICE_MODEL": "claude-sonnet-5",
    // The Council (design 2026-09-11 §3): three independent members over one
    // shared evidence pack, no search tool; and the lesson writer at settlement.
    "PIPELINE_COUNCIL_SONNET_MODEL": "claude-sonnet-5",
    "PIPELINE_COUNCIL_OPUS_MODEL": "claude-opus-5",
    "PIPELINE_COUNCIL_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "PIPELINE_LESSON_MODEL": "claude-haiku-4-5-20251001"
  }
  // secrets (wrangler secret put) — this list is WorkerEnv in src/worker.ts;
  // keep the two in step.
  //
  //   REQUIRED
  //     DATABASE_URL            Neon connection string
  //     DEVICE_TOKEN_SECRET     HMAC key for device tokens; also salts the mint throttle's ip hash
  //     ADMIN_SECRET            x-admin-secret header on /admin/*
  //
  //   REVENUE — without this, /v1/webhooks/revenuecat 401s EVERY event and
  //   every purchase silently grants nothing. Set it before shipping a paywall.
  //     REVENUECAT_WEBHOOK_SECRET
  //     APPLE_BUNDLE_ID         audience for Sign in with Apple; defaults to com.erikt.oracle
  //
  //   PIPELINE (the cron stays inert without the first one)
  //     PIPELINE_ENABLED        "true" to arm the cron pipeline
  //     ANTHROPIC_API_KEY
  //     TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, TELEGRAM_WEBHOOK_SECRET
  //     (PIPELINE_RESOLVE_MODEL_B is a DIFFERENT model from PIPELINE_RESOLVE_MODEL
  //      on purpose — see design 2026-09-04 §6.2. Setting both to the same model
  //      silently removes the error independence the second read exists to buy.)
  //     EXA_API_KEY             the Council's evidence packs (design 2026-09-11 §5); absent → empty packs
  //
  //   PUSH — absent, the hinge push at settle no-ops and the settle report
  //   says "push: 0 sent". Nothing else changes.
  //     ONESIGNAL_APP_ID, ONESIGNAL_API_KEY
}
